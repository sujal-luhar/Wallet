{
  "name": "wallet",
  "private": true,
  "scripts": {
    "setup": "docker compose up -d --wait && pnpm install && pnpm --filter @wallet/db db:deploy && pnpm --filter @wallet/db db:seed",
    "db:seed": "pnpm --filter @wallet/db db:seed",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": { 
    "node": "^26.5.0" 
  }
}
