{
  "name": "wallet",
  "private": true,
  "license": "MIT",
  "scripts": {
    "bootstrap": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:deploy": "pnpm --filter @wallet/db db:deploy",
    "db:seed": "pnpm --filter @wallet/db db:seed",
    "db:studio": "pnpm --filter @wallet/db db:studio",
    "db:reset": "docker compose down -v && node scripts/setup.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "^26.5.0"
  }
}
