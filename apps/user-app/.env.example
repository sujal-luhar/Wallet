# Matches docker-compose.yaml (Postgres on localhost:5433)
DATABASE_URL="postgresql://wallet:wallet@localhost:5433/wallet"

# `node scripts/setup.mjs` replaces this with a random value.
# user-app and merchant-app MUST use the same secret.
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3002"

# Email -> Mailpit (docker-compose). Open the inbox at http://localhost:8025
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Wallet <no-reply@wallet.local>"

# Google OAuth (optional, see README "Google sign-in"). Email + password works without it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (provider is wired up in packages/auth but currently unused)
# GITHUB_CLIENT_ID=""
# GITHUB_SECRET=""

# Public App URLs for Cross-Navigation & API Calls
NEXT_PUBLIC_MOCK_BANK_URL="http://localhost:3001"
NEXT_PUBLIC_MERCHANT_APP_URL="http://localhost:3003"

MOCK_BANK_API_SECRET="mock-bank-secret"

# Optional: comma-separated LAN hosts allowed to load the dev server (e.g. phone testing)
# ALLOWED_DEV_ORIGINS="192.168.1.5"
