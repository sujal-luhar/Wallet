# Matches docker-compose.yaml (Postgres on localhost:5433)
DATABASE_URL="postgresql://wallet:wallet@localhost:5433/wallet"

# `node scripts/setup.mjs` copies the same random value used by user-app.
# Must be identical to user-app's NEXTAUTH_SECRET.
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3003"

# Public App URLs for Cross-Navigation & API Calls
NEXT_PUBLIC_MOCK_BANK_URL="http://localhost:3001"
NEXT_PUBLIC_USER_APP_URL="http://localhost:3002"

MOCK_BANK_API_SECRET="mock-bank-secret"

# Optional: comma-separated LAN hosts allowed to load the dev server
# ALLOWED_DEV_ORIGINS="192.168.1.5"
