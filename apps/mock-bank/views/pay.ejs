<!DOCTYPE html>
<html>
<head>
  <title>Mock Bank Gateway</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 flex items-center justify-center min-h-screen p-4">
  <div class="w-full max-w-md bg-white border shadow-sm p-6">
    <h2 class="font-bold text-lg border-b pb-2 mb-4">🏦 Mock Bank Gateway</h2>
    
    <div class="bg-slate-50 p-3 mb-4 text-sm border">
      <p class="text-gray-500">Tx ID: <span class="font-mono font-semibold"><%= txId %></span></p>
      <p class="text-base font-bold text-gray-900 mt-1">Amount: ₹<%= amount %></p>
      <p class="text-base font-bold text-gray-800 mt-1"><%= type %></p>
    </div>

    <% if (error) { %>
      <div class="bg-red-100 text-red-700 text-xs p-2 mb-4"><%= error %></div>
    <% } %>

    <form method="POST" action="/mock-bank/process" class="space-y-4">
      <input type="hidden" name="txId" value="<%= txId %>">
      <input type="hidden" name="amount" value="<%= amount %>">
      <input type="hidden" name="type" value="<%= type %>">

      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">ENTER UPI PIN (1234)</label>
        <input type="password" name="pin" maxLength="4" placeholder="1234" required 
               class="w-full border p-2 text-center text-xl font-mono tracking-widest">
      </div>

      <button type="submit" name="action" value="SUCCESS" 
              class="w-full bg-black text-white py-2 text-sm font-semibold hover:bg-gray-800">
        Approve & Pay ₹<%= amount %>
      </button>

      <button type="submit" name="action" value="FAILED" 
              class="w-full bg-red-600 text-white py-2 text-sm font-semibold hover:bg-red-700">
        Simulate Failure
      </button>
    </form>
  </div>
</body>
</html>