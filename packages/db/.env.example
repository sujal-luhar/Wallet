# Local Docker Postgres (docker-compose.yaml).
# DATABASE_URL is used by the apps at runtime, DIRECT_DATABASE_URL by Prisma migrations.
DATABASE_URL="postgresql://wallet:wallet@localhost:5433/wallet"
DIRECT_DATABASE_URL="postgresql://wallet:wallet@localhost:5433/wallet"

# In production you can instead point DATABASE_URL at Prisma Accelerate
# (prisma:// or prisma+postgres://) and keep DIRECT_DATABASE_URL on the real database.
